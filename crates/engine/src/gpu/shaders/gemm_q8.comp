#version 450
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_control_flow_attributes : require

// Y[M,N] = epilogue(X[M,K] · W[N,K]ᵀ + b) on int8 tensor cores: X and W both quantized per
// 32 values along K (Q8_0: int8 values and one scale per block), 16×16×32 int8 products
// with i32 accumulation, each block's integer sums scaled by its row's and column's scales
// and summed in f32. (W is the GGUF's own Q8_0, exactly; X comes from `quantize_q8.wgsl`.)
//
// A workgroup computes a BM×BN tile of Y with (BM/WM)·(BN/WN) subgroups of 32, each owning
// a WM×WN block: (WM/16)·(WN/16) accumulators. BK-wide slices of X and W (int8, four to a
// word) and their scales are staged in workgroup memory, the next slice loaded into
// registers while the current one is multiplied. The staged W is [n][k], which is Wᵀ in
// column-major order, so it loads as the B operand directly.
//
// Each 32-wide block is multiplied into a fresh i32 accumulator and added, scaled, into f32
// registers element by element, which needs to know which (row, col) each lane's elements
// are: this is NVIDIA's arrangement (lane l, element e: row l/4 + 8·(e/4), column
// 2·(l%4) + e%2 + 8·((e/2)%2)), which the host checks with `coop_layout_i32.comp` before
// using the kernel. The epilogue (bias, activation, scale, accumulate) then writes those
// elements straight from registers.
//
// Specialization constants: BM, BN, BK, WM, WN, THREADS = (BM/WM)·(BN/WN)·32. Needs a
// subgroup size of 32, K % BK == 0, BK % 32 == 0; M and N may be anything.

layout(constant_id = 0) const uint BM = 128;
layout(constant_id = 1) const uint BN = 128;
layout(constant_id = 2) const uint BK = 64;
layout(constant_id = 3) const uint WM = 64;
layout(constant_id = 4) const uint WN = 32;
layout(constant_id = 5) const uint THREADS = 256;
layout(local_size_x_id = 5) in;

layout(push_constant) uniform Params {
    uint m;
    uint n;
    uint k;
    // Bit 0: add the bias. Bits 1–2: activation (0 none, 1 ReLU, 2 SiLU, 3 GELU). Bit 3:
    // accumulate.
    uint flags;
    float scale;
} p;

// X's int8 values, 16 to a vector, row-major [M][K/16], and its scales [M][K/32].
layout(set = 0, binding = 0) readonly buffer XQ { uvec4 xq[]; };
layout(set = 0, binding = 1) readonly buffer XS { float xs[]; };
// W's, [N][K/16] and [N][K/32].
layout(set = 0, binding = 2) readonly buffer WQ { uvec4 wq[]; };
layout(set = 0, binding = 3) readonly buffer WS { float wsc[]; };
layout(set = 0, binding = 4) readonly buffer Bias { float bias[]; };
layout(set = 0, binding = 5) buffer Y { float y[]; };

const uint SG_N = BN / WN;
const uint FM = WM / 16;
const uint FN = WN / 16;
// Blocks of 32 per slice, and vectors of 16 values per staged row.
const uint KB = BK / 32;
const uint KV = BK / 16;
// A staged row: KV vectors plus one of padding against bank conflicts.
const uint LD = KV + 1;
const uint A_VECS = BM * KV;
const uint B_VECS = BN * KV;
const uint A_LOADS = (A_VECS + THREADS - 1) / THREADS;
const uint B_LOADS = (B_VECS + THREADS - 1) / THREADS;
const uint SA_LOADS = (BM * KB + THREADS - 1) / THREADS;
const uint SB_LOADS = (BN * KB + THREADS - 1) / THREADS;

shared uvec4 xsh[BM * LD];
shared uvec4 wsh[BN * LD];
// Scales block-major: [block][row] and [block][col].
shared float xss[KB * BM];
shared float wss[KB * BN];

float activate(float v, uint kind) {
    if (kind == 1) {
        return max(v, 0.0);
    }
    if (kind == 2) {
        return v / (1.0 + exp(-v));
    }
    if (kind == 3) {
        // The error function as the CPU's `cpu::erf` computes it (Cody's rational
        // approximation, to about 1e-7), in f32.
        float x = v * 0.70710678;
        float t = 1.0 / (1.0 + 0.5 * abs(x));
        float e = 1.0 - t * exp(-x * x - 1.26551223 + t * (1.00002368 + t * (0.37409196
            + t * (0.09678418 + t * (-0.18628806 + t * (0.27886807 + t * (-1.13520398
            + t * (1.48851587 + t * (-0.82215223 + t * 0.17087277)))))))));
        return 0.5 * v * (1.0 + (x >= 0.0 ? e : -e));
    }
    return v;
}

void main() {
    const uint tid = gl_LocalInvocationIndex;
    const uint sg = gl_SubgroupID;
    const uint lane = gl_SubgroupInvocationID;
    const uint m0 = gl_WorkGroupID.y * BM;
    const uint n0 = gl_WorkGroupID.x * BN;
    const uint wm0 = (sg / SG_N) * WM;
    const uint wn0 = (sg % SG_N) * WN;
    const uint kv = p.k / 16;
    const uint kb = p.k / 32;
    // This lane's rows (r0, r0 + 8) and columns (c0, c0 + 1, c0 + 8, c0 + 9) in a 16×16 tile.
    const uint r0 = lane / 4;
    const uint c0 = (lane % 4) * 2;

    float acc[FM * FN * 8];
    [[unroll]] for (uint i = 0; i < FM * FN * 8; i++) {
        acc[i] = 0.0;
    }

    uvec4 xr[A_LOADS];
    uvec4 wr[B_LOADS];
    float sxr[SA_LOADS];
    float swr[SB_LOADS];
    // Loads slice t of X, W and their scales into registers (zeros past the edges).
    // (Written out twice: once before the loop, once for the next slice inside it.)
    [[unroll]] for (uint s = 0; s < A_LOADS; s++) {
        uint v = tid + s * THREADS;
        uint row = m0 + v / KV;
        xr[s] = uvec4(0);
        if (v < A_VECS && row < p.m) {
            xr[s] = xq[row * kv + v % KV];
        }
    }
    [[unroll]] for (uint s = 0; s < B_LOADS; s++) {
        uint v = tid + s * THREADS;
        uint row = n0 + v / KV;
        wr[s] = uvec4(0);
        if (v < B_VECS && row < p.n) {
            wr[s] = wq[row * kv + v % KV];
        }
    }
    [[unroll]] for (uint s = 0; s < SA_LOADS; s++) {
        uint v = tid + s * THREADS;
        uint row = m0 + v / KB;
        sxr[s] = 0.0;
        if (v < BM * KB && row < p.m) {
            sxr[s] = xs[row * kb + v % KB];
        }
    }
    [[unroll]] for (uint s = 0; s < SB_LOADS; s++) {
        uint v = tid + s * THREADS;
        uint row = n0 + v / KB;
        swr[s] = 0.0;
        if (v < BN * KB && row < p.n) {
            swr[s] = wsc[row * kb + v % KB];
        }
    }

    const coopmat<int, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> zero =
        coopmat<int, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0);

    const uint slices = p.k / BK;
    for (uint t = 0; t < slices; t++) {
        barrier();
        [[unroll]] for (uint s = 0; s < A_LOADS; s++) {
            uint v = tid + s * THREADS;
            if (v < A_VECS) {
                xsh[(v / KV) * LD + v % KV] = xr[s];
            }
        }
        [[unroll]] for (uint s = 0; s < B_LOADS; s++) {
            uint v = tid + s * THREADS;
            if (v < B_VECS) {
                wsh[(v / KV) * LD + v % KV] = wr[s];
            }
        }
        [[unroll]] for (uint s = 0; s < SA_LOADS; s++) {
            uint v = tid + s * THREADS;
            if (v < BM * KB) {
                xss[(v % KB) * BM + v / KB] = sxr[s];
            }
        }
        [[unroll]] for (uint s = 0; s < SB_LOADS; s++) {
            uint v = tid + s * THREADS;
            if (v < BN * KB) {
                wss[(v % KB) * BN + v / KB] = swr[s];
            }
        }
        barrier();

        if (t + 1 < slices) {
            const uint kx = (t + 1) * KV;
            const uint ks = (t + 1) * KB;
            [[unroll]] for (uint s = 0; s < A_LOADS; s++) {
                uint v = tid + s * THREADS;
                uint row = m0 + v / KV;
                if (v < A_VECS && row < p.m) {
                    xr[s] = xq[row * kv + kx + v % KV];
                }
            }
            [[unroll]] for (uint s = 0; s < B_LOADS; s++) {
                uint v = tid + s * THREADS;
                uint row = n0 + v / KV;
                if (v < B_VECS && row < p.n) {
                    wr[s] = wq[row * kv + kx + v % KV];
                }
            }
            [[unroll]] for (uint s = 0; s < SA_LOADS; s++) {
                uint v = tid + s * THREADS;
                uint row = m0 + v / KB;
                if (v < BM * KB && row < p.m) {
                    sxr[s] = xs[row * kb + ks + v % KB];
                }
            }
            [[unroll]] for (uint s = 0; s < SB_LOADS; s++) {
                uint v = tid + s * THREADS;
                uint row = n0 + v / KB;
                if (v < BN * KB && row < p.n) {
                    swr[s] = wsc[row * kb + ks + v % KB];
                }
            }
        }

        [[unroll]] for (uint b = 0; b < KB; b++) {
            coopmat<int8_t, gl_ScopeSubgroup, 16, 32, gl_MatrixUseA> a[FM];
            coopmat<int8_t, gl_ScopeSubgroup, 32, 16, gl_MatrixUseB> w[FN];
            float sx[FM * 2];
            vec2 sw[FN * 2];
            [[unroll]] for (uint i = 0; i < FM; i++) {
                coopMatLoad(a[i], xsh, (wm0 + i * 16) * LD + b * 2, LD,
                    gl_CooperativeMatrixLayoutRowMajor);
                sx[i * 2] = xss[b * BM + wm0 + i * 16 + r0];
                sx[i * 2 + 1] = xss[b * BM + wm0 + i * 16 + r0 + 8];
            }
            [[unroll]] for (uint j = 0; j < FN; j++) {
                coopMatLoad(w[j], wsh, (wn0 + j * 16) * LD + b * 2, LD,
                    gl_CooperativeMatrixLayoutColumnMajor);
                uint at = b * BN + wn0 + j * 16 + c0;
                sw[j * 2] = vec2(wss[at], wss[at + 1]);
                sw[j * 2 + 1] = vec2(wss[at + 8], wss[at + 9]);
            }
            [[unroll]] for (uint i = 0; i < FM; i++) {
                [[unroll]] for (uint j = 0; j < FN; j++) {
                    const uint o = (i * FN + j) * 8;
                    coopmat<int, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> c =
                        coopMatMulAdd(a[i], w[j], zero);
                    [[unroll]] for (uint e = 0; e < 8; e++) {
                        float s = sx[i * 2 + e / 4] * sw[j * 2 + (e / 2) % 2][e % 2];
                        acc[o + e] += float(c[e]) * s;
                    }
                }
            }
        }
    }


    const bool has_bias = (p.flags & 1) != 0;
    const uint kind = (p.flags >> 1) & 3;
    const bool accumulate = (p.flags & 8) != 0;
    [[unroll]] for (uint i = 0; i < FM; i++) {
        [[unroll]] for (uint j = 0; j < FN; j++) {
            [[unroll]] for (uint e = 0; e < 8; e++) {
                uint row = m0 + wm0 + i * 16 + r0 + (e / 4) * 8;
                uint col = n0 + wn0 + j * 16 + c0 + e % 2 + ((e / 2) % 2) * 8;
                if (row < p.m && col < p.n) {
                    float v = acc[(i * FN + j) * 8 + e];
                    if (has_bias) {
                        v += bias[col];
                    }
                    v = activate(v, kind) * p.scale;
                    uint at = row * p.n + col;
                    if (accumulate) {
                        v += y[at];
                    }
                    y[at] = v;
                }
            }
        }
    }
}
